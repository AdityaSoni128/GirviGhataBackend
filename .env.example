# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Application
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Storage
STORAGE_PROVIDER=cloudinary
STORAGE_LOCAL_PATH=./storage

# S3 - not currently used when STORAGE_PROVIDER=cloudinary
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Redis - currently not required
REDIS_URL=

# KYC encryption
KYC_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:4200

# Seed
# Required only when running seed.ts outside production
SEED_OWNER_PASSWORD=replace-with-a-strong-development-password